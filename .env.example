PORT=3000
NODE_ENV=development

# PostgreSQL (локальный Docker или Neon)
DATABASE_URL=postgres://meme:meme@localhost:5432/meme_platform

# Секреты JWT — сгенерируйте свои: openssl rand -hex 32
JWT_ACCESS_SECRET=change_me_access_secret_min_32_chars
JWT_REFRESH_SECRET=change_me_refresh_secret_min_32_chars
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d

# CORS: список разрешённых origin через запятую
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:5500

# Лимит тела запроса (защита от DoS)
JSON_BODY_LIMIT=100kb

# Учётные данные администратора для seed
ADMIN_EMAIL=admin@memes.local
ADMIN_PASSWORD='Admin#1234'
